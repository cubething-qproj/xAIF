      {
        "nodeID": 1,
        "type": "L",
        "text": "Fredrich Engels: the necessity of authority, and of imperious authority at that, will nowhere be found more evident than on board a ship on the high seas"
      },
      {
        "nodeID": 2,
        "type": "YA",
        "text": "Asserting",
        "pta": {
          "transformations": [
            "activization",
