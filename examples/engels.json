        "nodeID": 32,
        "type": "YA",
        "text": "Asserting"
      },
      {
        "nodeID": 33,
        "type": "I",
        "text": "Authority on a ship at sea is different from the authority entrusted in a delegate",
        "pta": {
          "subject": "Authority on a ship at sea",
          "predicate": "is different from the authority entrusted in a delegate",
          "kind": "V",
          "scope": "p"
        }
      },
