      },
      {
        "nodeID": 6,
        "type": "L",
        "text": "Fredrich Engels: There, in time of danger, the lives of all depend on the instantaneous and absolute obedience of all to the will of one"
      },
      {
        "nodeID": 7,
        "type": "YA",
        "text": "Asserting",
        "pta": {
          "transformations": [
            "activization"
          ]
        }
      },
      {
        "nodeID": 8,
        "type": "I",
        "text": "Obedience to authority saves lives on a ship at sea.",
        "pta": {
          "subject": "obedience to authority",
          "predicate": "saves lives on a ship at sea",
          "kind": "F",
          "scope": "p"
        }
      },
      {
